# App settings (copy to .env)
DBAD_OPENROUTER_API_KEY=
DBAD_TAVILY_API_KEY=
# DBAD_DEFAULT_MODEL=anthropic/claude-haiku-5.5
# DBAD_JUDGE_MODEL=

# Langfuse tracing + evals (see docker/langfuse). Keys match LANGFUSE_INIT_PROJECT_* there.
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
LANGFUSE_BASE_URL=http://localhost:3000
